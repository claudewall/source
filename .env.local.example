# Copy to .env.local and fill in.

# MongoDB Atlas — connection string from your cluster
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=claudewall

# Auth.js v5 — generate with: openssl rand -base64 32
AUTH_SECRET=

# GitHub OAuth App — https://github.com/settings/developers
# There is only one OAuth app. Authorization callback URL is the
# production domain: https://claudewall.com/api/auth/callback/github
# Local dev cannot complete sign-in against it — test auth on the deploy.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Public origin Auth.js advertises to GitHub and that the CLI device
# flow embeds in its verification URI. Always the production domain.
AUTH_URL=https://claudewall.com
NEXTAUTH_URL=https://claudewall.com
